<mxfile host="Electron" version="29.6.1"><diagram name="Page-1" id="diagram-1"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title-group" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="1"><mxGeometry height="83" width="2060" x="50" y="30" as="geometry" /></mxCell><mxCell id="title-text" style="text;html=1;resizable=1;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=30;fontStyle=1;fontFamily=Helvetica;" value="Give a Strands agent a tool: reading notices with Amazon Textract" vertex="1" parent="title-group"><mxGeometry height="42" width="1000" as="geometry" /></mxCell><mxCell id="subtitle-text" style="text;html=1;resizable=0;points=[];autosize=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=16;fontFamily=Helvetica;" value="One new @tool lets a Bedrock-powered agent turn photos and PDFs of public notices into plain-language answers" vertex="1" parent="title-group"><mxGeometry height="25" width="1000" x="5" y="40" as="geometry" /></mxCell><mxCell id="title-separator" style="line;strokeWidth=2;html=1;fontSize=14;strokeColor=#FF9900;fontFamily=Helvetica;" value="" vertex="1" parent="title-group"><mxGeometry height="10" width="2050" x="5" y="70" as="geometry" /></mxCell><mxCell id="users-container" style="fillColor=#f5f5f5;strokeColor=light-dark(#666666,#D4D4D4);rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#333333;fontFamily=Helvetica;container=1;collapsible=0;shadow=1;strokeWidth=1;perimeterSpacing=0;" value="User" vertex="1" parent="1"><mxGeometry x="60" y="380" width="107" height="120" as="geometry" /></mxCell><mxCell id="users-icon" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,